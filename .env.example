# Exemplo de configuração por variáveis de ambiente.
# Copie para `.env` e ajuste os valores: cp .env.example .env
# O docker-compose.yml interpola ${VAR} a partir do .env e injeta nos contêineres.
# Fora do Docker, os serviços usam os defaults do código (ver README.md).

# API Django (lidas em config/settings.py).
DJANGO_SECRET_KEY=dev-insecure-synapseshop-change-me
DJANGO_DEBUG=true

# (Aula 7) Tempos de vida do JWT e throttling (config/settings.py).
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7
THROTTLE_ANON=20/min
THROTTLE_USER=200/min
THROTTLE_LOGIN=5/min

# (Aula 7) Credenciais dos usuários demo criados no start da API
# pelo comando `seed_demo_users` (cenários de login/denegado no Postman).
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin
SEED_ADMIN_EMAIL=admin@synapseshop.local
SEED_USER_USERNAME=user
SEED_USER_PASSWORD=user
SEED_USER_EMAIL=user@synapseshop.local

# PostgreSQL (compartilhado entre postgres, api e inventory).
POSTGRES_DB=synapseshop
POSTGRES_USER=synapseshop
POSTGRES_PASSWORD=synapseshop
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# (Aula 8) Cache-aside com Redis.
# REDIS_URL: o Compose injeta o host `redis`; fora do Docker use localhost.
REDIS_URL=redis://redis:6379/1
# CACHE_ENABLED=false desliga o cache (fallback em memória local), útil para o
# comparativo de desempenho antes/depois sem alterar o código.
CACHE_ENABLED=true
# TTLs do cache, em segundos (lista paginada, detalhe do item e detalhe do pedido).
CACHE_TTL_LISTA=60
CACHE_TTL_DETALHE=300
# (Aula 11) TTL do detalhe do pedido. Curto de propósito: o estado do pedido muda
# por eventos de outros processos e, embora a invalidação exista, o TTL é o que
# limita o estrago quando uma invalidação se perde.
CACHE_TTL_PEDIDO=60

# (Aula 9) Mensageria assíncrona com RabbitMQ (Camada 5). Transporte alternativo:
# com MENSAGERIA_BROKER=rabbitmq a API e os dois workers usam este bloco.
# RABBITMQ_HOST: o Compose injeta o host `rabbitmq`; fora do Docker use localhost.
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
# MESSAGERIA_ENABLED=false desliga a publicação de eventos: o pedido é gravado
# e responde 202 com `evento_publicado: false`, isolando o custo da sincronia.
MESSAGERIA_ENABLED=true
# A exchange é única para os três eventos do fluxo; o roteamento é por
# routing key. Trocar de exchange exigiria recriar as três filas e ligações.
RABBITMQ_EXCHANGE=pedidos.events
RABBITMQ_FILA_PEDIDO_CRIADO=pedidos.pedidocriado
RABBITMQ_FILA_PEDIDO_CRIADO_DLQ=pedidos.pedidocriado.dlq
RABBITMQ_ROUTING_KEY_PEDIDO_CRIADO=pedido.criado
RABBITMQ_FILA_PAGAMENTO_PROCESSADO=pagamentos.pagamentoprocessado
RABBITMQ_FILA_PAGAMENTO_PROCESSADO_DLQ=pagamentos.pagamentoprocessado.dlq
RABBITMQ_ROUTING_KEY_PAGAMENTO_PROCESSADO=pagamento.processado
RABBITMQ_FILA_NOTIFICACAO_ENVIADA=notificacoes.notificacaoenviada
RABBITMQ_FILA_NOTIFICACAO_ENVIADA_DLQ=notificacoes.notificacaoenviada.dlq
RABBITMQ_ROUTING_KEY_NOTIFICACAO_ENVIADA=notificacao.enviada
RABBITMQ_DLX=pedidos.dlx
RABBITMQ_PREFETCH=1
# Política de reentrega do consumidor: 1 + MAX_RETRIES = 4 tentativas no total.
MENSAGERIA_MAX_RETRIES=3
MENSAGERIA_BACKOFF_BASE_MS=250
MENSAGERIA_BACKOFF_MAX_MS=5000
# (Aula 11) Batimento de ociosidade do consumidor, em segundos. Sem tráfego não
# há log por mensagem, e a pergunta "o worker está vivo?" precisa ter resposta em
# log. 0 desliga o batimento (não o consumidor).
MENSAGERIA_HEARTBEAT_S=60
# Prazo de validade da chave de deduplicação (86400 s = 24 h).
IDEMPOTENCIA_TTL_SEGUNDOS=86400
# DoD "erro forcado": chaves rejeitadas pelo worker para validar reentrega/DLQ.
# Exemplo: PEDIDO_WORKER_FALHA_IDEM_KEYS=pedido-falha-001
PEDIDO_WORKER_FALHA_IDEM_KEYS=
# (Aula 11) Mesmo gancho no segundo elo do fluxo. Os padrões casam com a chave do
# evento (`pagamento:<id>`) **ou** com `pedido:<id>` — o id do pagamento só existe
# depois que a API o grava, e quem provoca a falha é quem ainda não o tem.
# Exemplo: NOTIFICACAO_WORKER_FALHA_IDEM_KEYS=pedido:*
NOTIFICACAO_WORKER_FALHA_IDEM_KEYS=

# (Aula 10) Mensageria assíncrona com Apache Kafka — broker padrão (Camada 5).
# MENSAGERIA_BROKER escolhe o transporte de TODOS os processos (api,
# pedido-worker e notificacao-worker). Um valor divergente entre eles faria a API
# publicar num broker e o worker procurar no outro, por isso a escolha é única e
# central.
MENSAGERIA_BROKER=kafka
# KAFKA_BOOTSTRAP_SERVERS tem dois valores legítimos, porque o broker anuncia
# listeners separados para redes diferentes:
#   - dentro do Compose (api e workers):    kafka:29092
#   - no host, para smoke test e benchmark: localhost:9092
# Se o bootstrap apontar para o listener interno e você rodar um script no host,
# a conexão falha com "Host resolution failure": o broker responde com o endereço
# que ele anuncia, e `kafka` não resolve fora da rede do Compose.
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPICO_PEDIDO_CRIADO=pedidos.pedidocriado
KAFKA_TOPICO_PEDIDO_CRIADO_DLQ=pedidos.pedidocriado.dlq
KAFKA_TOPICO_PAGAMENTO_PROCESSADO=pagamentos.pagamentoprocessado
KAFKA_TOPICO_PAGAMENTO_PROCESSADO_DLQ=pagamentos.pagamentoprocessado.dlq
KAFKA_TOPICO_NOTIFICACAO_ENVIADA=notificacoes.notificacaoenviada
KAFKA_TOPICO_NOTIFICACAO_ENVIADA_DLQ=notificacoes.notificacaoenviada.dlq
# Partições = unidade de paralelismo. Mais consumidores que partições só produz
# consumidores ociosos no grupo.
KAFKA_PARTICOES=3
KAFKA_REPLICAS=1
# Retenção do log em ms (604800000 = 7 dias). A DLQ retém 4x esse valor.
KAFKA_RETENTION_MS=604800000
KAFKA_CLEANUP_POLICY=delete
# Consumidores com o mesmo group.id dividem as partições entre si.
# (Aula 11) O notificacao-worker tem grupo próprio: escalar um fluxo não pode
# disputa as partições do outro.
KAFKA_GRUPO_CONSUMIDORES=pedido-worker
KAFKA_GRUPO_NOTIFICACAO=notificacao-worker
# earliest = um grupo novo reprocessa o log retido a partir do início.
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_PRODUCER_ACKS=all
KAFKA_PRODUCER_LINGER_MS=5
KAFKA_POLL_TIMEOUT_S=1.0
KAFKA_SESSION_TIMEOUT_MS=10000
KAFKA_MAX_POLL_INTERVAL_MS=300000

# (Opcional) URL completa do inventário (inventory/app/db.py).
# Se definida, tem prioridade sobre as variáveis POSTGRES_*.
# DATABASE_URL=postgresql+psycopg://synapseshop:synapseshop@postgres:5432/synapseshop