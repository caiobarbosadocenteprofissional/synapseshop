# Exemplo de configuração por variáveis de ambiente.
# Copie para `.env` e ajuste os valores: cp .env.example .env
# O docker-compose.yml interpola ${VAR} a partir do .env e injeta nos contêineres.
# Fora do Docker, os serviços usam os defaults do código (ver README.md).

# API Django (lidas em config/settings.py).
DJANGO_SECRET_KEY=dev-insecure-synapseshop-change-me
DJANGO_DEBUG=true

# PostgreSQL (compartilhado entre postgres, api e inventory).
POSTGRES_DB=synapseshop
POSTGRES_USER=synapseshop
POSTGRES_PASSWORD=synapseshop
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# (Opcional) URL completa do inventário (inventory/app/db.py).
# Se definida, tem prioridade sobre as variáveis POSTGRES_*.
# DATABASE_URL=postgresql+psycopg://synapseshop:synapseshop@postgres:5432/synapseshop