# Contexto de build mínimo: acelera o build e reduz o tamanho da imagem.
.gitignore
.git/
.opencode/
.env
.env.*
*.env

# Especificações/planejamento não entram no container.
specs/
docs/
README.md
PROMPTS.md

# Serviço independente (imagem própria) e utilitários fora da imagem da API.
inventory/
scripts/
mock_llm.py

# Banco local (SQLite) e arquivos gerados.
db.sqlite3
*.sqlite3

# Artefatos Python.
__pycache__/
*.py[cod]
*.egg-info/
*.whl
.venv/
venv/
env/

# Testes / ferramentas locais.
.pytest_cache/
.coverage
coverage.xml
.mypy_cache/
.ruff_cache/
htmlcov/
.tox/

# IDE / OS.
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
*.log