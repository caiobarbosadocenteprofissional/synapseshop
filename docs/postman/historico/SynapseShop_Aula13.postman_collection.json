            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Notebook 16GB\",\n    \"description\": \"Notebook de alto desempenho\",\n    \"price\": \"4999.90\",\n    \"category\": {{category_id}},\n    \"is_active\": true\n}"
            },
