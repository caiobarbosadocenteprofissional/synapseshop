    {
      "name": "Fluxo de Pedido",
      "item": [
        {
          "name": "POST /api/v1/pedidos/ — criar (Idempotency-Key + X-Trace-Id)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created (evento publicado)', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Evento publicado', () => pm.expect(body.evento_publicado).to.be.true);",
                  "pm.test('X-Trace-Id ecoado na resposta', () => pm.expect(pm.response.headers.get('X-Trace-Id')).to.eql(pm.collectionVariables.get('trace_id')));",
                  "pm.test('Correlation id igual ao X-Trace-Id', () => pm.expect(body.correlation_id).to.eql(pm.collectionVariables.get('trace_id')));",
                  "pm.collectionVariables.set('pedido_id', String(body.id));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": {
              "Content-Type": "application/json",
              "Authorization": "Bearer {{user_token}}",
              "Idempotency-Key": "{{idempotency_key}}",
              "X-Trace-Id": "{{trace_id}}"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"itens\": [\n        { \"item_id\": {{item_id}}, \"quantidade\": 2 }\n    ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/pedidos/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "pedidos"]
            }
          }
        },
        {
          "name": "POST /api/v1/pedidos/ — repetir (idempotente, 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK (pedido existente)', () => pm.response.to.have.status(200));",
                  "pm.test('Mesmo pedido', () => pm.expect(String(pm.response.json().id)).to.eql(pm.collectionVariables.get('pedido_id')));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": {
              "Content-Type": "application/json",
              "Authorization": "Bearer {{user_token}}",
              "Idempotency-Key": "{{idempotency_key}}",
              "X-Trace-Id": "{{trace_id}}"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"itens\": [\n        { \"item_id\": {{item_id}}, \"quantidade\": 2 }\n    ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/pedidos/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "pedidos"]
            }
          }
        },
        {
          "name": "GET /api/v1/pedidos/{{pedido_id}}/ — consultar (cache)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('X-Cache presente', () => pm.expect(['HIT', 'MISS', 'BYPASS']).to.include(pm.response.headers.get('X-Cache')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": { "Authorization": "Bearer {{user_token}}" },
            "url": {
              "raw": "{{base_url}}/api/v1/pedidos/{{pedido_id}}/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "pedidos", "{{pedido_id}}"]
            }
          }
        },
        {
          "name": "POST /api/v1/pedidos/{{pedido_id}}/pagamento/ — pagar",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Evento publicado', () => pm.expect(pm.response.json().evento_publicado).to.be.true);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": {
              "Content-Type": "application/json",
              "Authorization": "Bearer {{user_token}}",
              "X-Trace-Id": "{{trace_id}}"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"resultado\": \"APROVADO\",\n    \"forma_pagamento\": \"pix\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/pedidos/{{pedido_id}}/pagamento/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "pedidos", "{{pedido_id}}", "pagamento"]
            }
          }
        },
