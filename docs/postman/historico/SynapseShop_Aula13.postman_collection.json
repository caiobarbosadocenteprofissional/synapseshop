          "name": "GET /api/v1/items/ — listar com filtros",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Envelope de paginação', () => pm.expect(pm.response.json()).to.have.property('results'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": { "Authorization": "Bearer {{user_token}}" },
            "url": {
              "raw": "{{base_url}}/api/v1/items/?search=Notebook&is_active=true&category={{category_id}}&ordering=price",
              "host": ["{{base_url}}"],
              "query": [
                { "key": "search", "value": "Notebook" },
                { "key": "is_active", "value": "true" },
                { "key": "category", "value": "{{category_id}}" },
                { "key": "ordering", "value": "price" }
