                  "pm.test('Página do ReDoc', () => pm.expect(pm.response.text().toLowerCase()).to.include('redoc'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/docs/redoc/",
              "host": ["{{base_url}}"],
              "path": ["docs", "redoc"]
            }
          }
        },
