  "item": [
    {
      "name": "Documentação",
      "item": [
        {
          "name": "GET /docs/ — Swagger UI",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Página do Swagger UI', () => pm.expect(pm.response.text()).to.include('swagger-ui'));",
                  "pm.test('Aponta para /openapi.yaml', () => pm.expect(pm.response.text()).to.include('/openapi.yaml'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/docs/",
              "host": ["{{base_url}}"],
              "path": ["docs"]
            }
          }
        },
        {
          "name": "GET /docs/redoc/ — ReDoc",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
