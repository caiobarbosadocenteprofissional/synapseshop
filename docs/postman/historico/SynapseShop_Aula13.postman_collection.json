          "request": {
            "method": "GET",
            "header": { "Authorization": "Bearer {{user_token}}" },
            "url": {
              "raw": "{{base_url}}/api/v1/notificacoes/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "notificacoes"]
