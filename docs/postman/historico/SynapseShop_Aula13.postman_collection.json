    {
      "name": "Auth (JWT)",
      "item": [
        {
          "name": "POST /api/v1/auth/token/ — login admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Claim role = admin', () => pm.expect(body.role).to.eql('admin'));",
                  "pm.collectionVariables.set('admin_token', body.access);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": { "Content-Type": "application/json" },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"{{admin_username}}\",\n    \"password\": \"{{admin_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/token/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "token"]
            }
          }
        },
        {
          "name": "POST /api/v1/auth/token/ — login user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('user_token', pm.response.json().access);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": { "Content-Type": "application/json" },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"{{user_username}}\",\n    \"password\": \"{{user_password}}\"\n}"
