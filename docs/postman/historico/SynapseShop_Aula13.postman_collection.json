              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('item_id', String(pm.response.json().id));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": {
              "Content-Type": "application/json",
              "Authorization": "Bearer {{admin_token}}"
