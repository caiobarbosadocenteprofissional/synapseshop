    {
      "name": "Throttling",
      "item": [
        {
          "name": "POST /api/v1/auth/token/ — 6º login no minuto (429)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const url = pm.collectionVariables.get('base_url') + '/api/v1/auth/token/';",
                  "const creds = JSON.stringify({",
                  "  username: pm.collectionVariables.get('user_username'),",
                  "  password: pm.collectionVariables.get('user_password')",
                  "});",
                  "const burn = (i, done) => {",
                  "  if (i >= 5) return done();",
                  "  pm.sendRequest({",
                  "    url: url,",
                  "    method: 'POST',",
                  "    header: { 'Content-Type': 'application/json' },",
                  "    body: { mode: 'raw', raw: creds }",
                  "  }, () => burn(i + 1, done));",
                  "};",
                  "burn(0, () => {});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 429 Too Many Requests (throttled)', () => pm.response.to.have.status(429));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": {
              "Content-Type": "application/json"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"{{user_username}}\",\n    \"password\": \"{{user_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/token/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "token"]
            }
          }
        }
